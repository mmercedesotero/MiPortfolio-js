---
import TimelineItem from "@/components/TimelineItem.astro"
import { getText } from "@/utils/i18n"
import { getYearFromDate } from "@/utils/date"
import type { SectionProps } from "@/types"

const { cv, lang } = Astro.props as SectionProps
const t = getText(lang)
---

<div>
  <h3>{t.sections.experience.title}</h3>
  <ul>
    {
      cv.experience.map(({ name, position, startDate, endDate, summary }) => (
        <TimelineItem
          title={name}
          subtitle={position}
          period={`${getYearFromDate(startDate)} - ${endDate ? getYearFromDate(endDate) : t.present}`}
          start={startDate}
          description={summary}
        />
      ))
    }
  </ul>
</div>

<style>
  h3 {
    margin-bottom: 1.25rem;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--ink);
  }
</style>
