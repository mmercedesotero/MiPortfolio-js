---
import GitHub from "@/icons/GitHub.astro"
import WorldMap from "@/icons/WorldMap.astro"
import Section from "@/components/Section.astro"
import { getText } from "@/utils/i18n"
import type { SectionProps } from "@/types"

const { cv, lang } = Astro.props as SectionProps
const t = getText(lang)
const { eyebrow, title } = t.sections.projects
---

<Section id="projects" eyebrow={eyebrow} title={title}>
  <ul class="projects">
    {
      cv.projects.map(({ name, description, highlights, isActive, featured, links }) => (
        <li class:list={{ featured }}>
          <article>
            <header>
              <h3>{name}</h3>
              {isActive && (
                <span class="status">
                  <i aria-hidden="true" />
                  {t.ongoing}
                </span>
              )}
            </header>

            <p>{description}</p>

            <ul class="tags">
              {highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>

            <footer class="no-print">
              {links.map(({ label, url, type }) => (
                <a class:list={["link", type]} href={url} target="_blank" rel="noopener noreferrer">
                  {type === "github" ? <GitHub /> : <WorldMap />}
                  {label}
                </a>
              ))}
            </footer>
          </article>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    padding: 1.15rem 1.25rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  li.featured article {
    border-top: 3px solid var(--olive);
  }

  article:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px -14px #564d0670;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  h3 {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: 999px;
    background: #09e74124;
    color: #0a6b24;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--live);
    animation: flicker 3s ease-in infinite;
  }

  p {
    flex: 1;
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tags li {
    padding: 0.2rem 0.65rem;
    border-radius: 6px;
    background: #564d0620;
    color: #3d3a1a;
    font-size: 0.72rem;
    font-weight: 600;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.25rem;
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.5rem 0.9rem;
    border: 1px solid #564d0645;
    border-radius: 8px;
    background: transparent;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .link:hover {
    background: #564d0620;
    border-color: var(--olive);
  }

  .link.live {
    background: var(--olive-dark);
    border-color: var(--olive-dark);
    color: #fff;
  }

  .link.live:hover {
    background: var(--olive);
  }

  @keyframes flicker {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }

  @media (width <= 700px) {
    .projects {
      grid-template-columns: 1fr;
    }

    article {
      padding: 1rem;
    }
  }

  @media print {
    .status i {
      animation: none;
    }
  }
</style>
