---
import Section from "../Section.astro"
import { getYearFromDate } from "@/utils/date"
import type { CV } from "@/cv"

interface Props {
  cv: CV
  lang: "es" | "en"
}

const { cv, lang } = Astro.props
const { education } = cv
---

<Section title={lang === "es" ? "Educación" : "Education"}>
  <ul>
    {
      education.map(({ institution, startDate, endDate, area }) => {
        const startYear = getYearFromDate(startDate)
        const endYear = endDate
          ? getYearFromDate(endDate)
          : lang === "es"
            ? "En curso"
            : "Present"
        const years = `${startYear} - ${endYear}`

        return (
          <li>
            <article>
              <header>
                <div>
                  <h3>{institution}</h3>
                </div>

                <time>{years}</time>
              </header>

              <footer>
                <p>{area}</p>
              </footer>
            </article>
          </li>
        )
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-top: 10px;
    
  }

  article h3 {
    font-weight: 500;
    color: #111;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
  }
</style>