---
import Mail from "@/icons/Mail.astro"
import Phone from "@/icons/Phone.astro"
import LinkedIn from "@/icons/LinkedIn.astro"
import GitHub from "@/icons/GitHub.astro"
import WorldMap from "@/icons/WorldMap.astro"
import { getText } from "@/utils/i18n"
import type { SectionProps } from "@/types"

const { cv, lang } = Astro.props as SectionProps
const t = getText(lang)
const { name, label, image, location, profiles, phone, email } = cv.basics

const SOCIAL_ICONS: Record<string, typeof GitHub> = { GitHub, LinkedIn }
const socialProfiles = profiles.filter(({ network }) => network in SOCIAL_ICONS)

// Para imprimir: textos cortos (la URL completa sigue siendo el link en el PDF)
const printLinks: { text: string; href: string }[] = [
  ...(email ? [{ text: email, href: `mailto:${email}` }] : []),
  ...(phone ? [{ text: phone, href: `tel:${phone}` }] : []),
  ...socialProfiles.map(({ network, username, url }) => ({ text: `${network}: ${username}`, href: url }))
]
---

<section id="top">
  <div class="info">
    <p class="greeting">{t.hero.greeting}</p>
    <h1>{name}</h1>
    <h2>{label}</h2>

    <span class="location">
      <WorldMap />
      {location.address}, {location.region}
    </span>

    <div class="actions no-print">
      <a class="btn primary" href="#projects">{t.hero.viewProjects}</a>
      <a class="btn" href="#contact">{t.hero.contactMe}</a>
    </div>

    <div class="social no-print">
      {
        email && (
          <a href={`mailto:${email}`} title={t.hero.email(name, email)} aria-label={t.hero.email(name, email)}>
            <Mail />
          </a>
        )
      }
      {
        phone && (
          <a href={`tel:${phone}`} title={t.hero.phone(name, phone)} aria-label={t.hero.phone(name, phone)}>
            <Phone />
          </a>
        )
      }
      {
        socialProfiles.map(({ network, url }) => {
          const Icon = SOCIAL_ICONS[network]

          return (
            <a
              href={url}
              title={t.hero.profile(name, network)}
              aria-label={t.hero.profile(name, network)}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon />
            </a>
          )
        })
      }
    </div>

    <p class="print">
      {printLinks.map(({ text, href }, i) => (
        <>
          <a href={href}>{text}</a>
          {i < printLinks.length - 1 && " • "}
        </>
      ))}
    </p>
  </div>

  <figure>
    <img src={image} alt={name} width="260" height="260" />
  </figure>
</section>

<style>
  section {
    max-width: 960px;
    margin: 0 auto;
    padding-block: 4.5rem 3rem;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 3rem;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .greeting {
    color: var(--olive);
    font-weight: 700;
    font-size: 0.95rem;
  }

  h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  h2 {
    color: #3a3a3a;
    font-weight: 500;
    font-size: 1.1rem;
    line-height: 1.4;
  }

  @media (width > 700px) {
    h2 {
      white-space: nowrap;
    }
  }

  .location {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--olive);
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--olive-dark);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .btn:hover {
    background: var(--olive-soft);
    transform: translateY(-2px);
  }

  .btn.primary {
    background: var(--olive-dark);
    border-color: var(--olive-dark);
    color: #fff;
  }

  .btn.primary:hover {
    background: var(--olive);
  }

  .social {
    display: flex;
    gap: 6px;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: #575656;
    background-color: #564d0618;
    border: 1px solid #564d0630;
    border-radius: 8px;
    transition: all 0.3s ease;
  }

  .social a:hover {
    background: #564d0630;
    border-color: #564d0650;
    transform: translateY(-2px);
  }

  img {
    display: block;
    width: 260px;
    height: 260px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 24px;
    border: 4px solid #fff;
    box-shadow: 12px 12px 0 #564d0640;
  }

  @media (width <= 700px) {
    section {
      grid-template-columns: 1fr;
      padding-block: 2.5rem 1.5rem;
      gap: 2rem;
      text-align: center;
    }

    figure {
      order: -1;
      margin: 0 auto;
    }

    img {
      width: 190px;
      height: 190px;
      box-shadow: 8px 8px 0 #564d0640;
    }

    .info {
      align-items: center;
    }
  }

  @media print {
    section {
      padding-block: 0 0.5rem;
      gap: 1.5rem;
    }

    img {
      width: 130px;
      height: 130px;
      box-shadow: none;
      border: 1px solid #564d0640;
    }

    h1 {
      font-size: 2.2rem;
    }

    h2 {
      white-space: normal;
    }

    .print {
      margin-top: 0.4rem;
      color: var(--olive);
      font-size: 0.85rem;
      font-weight: 600;
    }
  }
</style>
