---
import Section from "@/components/Section.astro"
import HTML from "@/icons/html.astro"
import CSS from "@/icons/css.astro"
import JavaScript from "@/icons/javascript.astro"
import TypeScript from "@/icons/type.astro"
import Git from "@/icons/git.astro"
import GitHub from "@/icons/GitHub.astro"
import Haskell from "@/icons/Haskell.astro"
import Python from "@/icons/Python.astro"
import C from "@/icons/C.astro"
import Cmasmas from "@/icons/Cmasmas.astro"
import Java from "@/icons/java.astro"
import React from "@/icons/react.astro"
import AstroIcon from "@/icons/astro.astro"
import Node from "@/icons/node.astro"
import Express from "@/icons/express.astro"
import Spring from "@/icons/spring.astro"
import Database from "@/icons/database.astro"
import Docker from "@/icons/docker.astro"
import RabbitMQ from "@/icons/rabbitmq.astro"
import Postman from "@/icons/postman.astro"
import { getText, getLevelScore } from "@/utils/i18n"
import type { SectionProps } from "@/types"

const { cv, lang } = Astro.props as SectionProps
const { eyebrow, title } = getText(lang).sections.skills

const SKILL_ICONS: Record<string, typeof HTML> = {
  HTML,
  CSS,
  JavaScript,
  TypeScript,
  Git,
  GitHub,
  Python,
  Haskell,
  C,
  Cmasmas,
  Java,
  React,
  "React Native": React,
  Astro: AstroIcon,
  "Node.js": Node,
  Express,
  "Spring Boot": Spring,
  SQL: Database,
  MySQL: Database,
  Docker,
  RabbitMQ,
  Postman
}

// Nombres del JSON que se muestran distinto en pantalla
const DISPLAY_NAMES: Record<string, string> = { Cmasmas: "C++" }

// Agrupa por categoría respetando el orden del JSON
const groups = new Map<string, typeof cv.skills>()
for (const skill of cv.skills) {
  groups.set(skill.category, [...(groups.get(skill.category) ?? []), skill])
}
---

<Section id="skills" eyebrow={eyebrow} title={title}>
  <div class="groups">
    {
      [...groups].map(([category, skills]) => (
        <div class="group">
          <h3>{category}</h3>
          <ul>
            {skills.map(({ name, level }) => {
              const Icon = SKILL_ICONS[name]
              const score = getLevelScore(level)

              return (
                <li>
                  <span class="name">
                    <span class="icon">{Icon && <Icon />}</span>
                    {DISPLAY_NAMES[name] ?? name}
                  </span>
                  <span class="level" title={level}>
                    <span class="meter" aria-hidden="true">
                      {[1, 2, 3].map((n) => (
                        <i class:list={{ on: n <= score }} />
                      ))}
                    </span>
                    {level}
                  </span>
                </li>
              )
            })}
          </ul>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .groups {
    columns: 2;
    column-gap: 1.25rem;
  }

  .icon {
    display: inline-flex;
    width: 16px;
    justify-content: center;
  }

  .group {
    break-inside: avoid;
    margin-bottom: 1.25rem;
    padding: 1.25rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  h3 {
    margin-bottom: 0.9rem;
    color: var(--olive);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.4rem 0.7rem;
    border-radius: 8px;
    background: #564d0614;
    transition: background 0.2s ease;
  }

  li:hover {
    background: #564d0626;
  }

  .name {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .level {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #4a3838;
    font-size: 0.72rem;
    font-weight: 500;
  }

  .meter {
    display: inline-flex;
    gap: 3px;
  }

  .meter i {
    width: 14px;
    height: 5px;
    border-radius: 3px;
    background: #00000020;
  }

  .meter i.on {
    background: var(--olive);
  }

  @media (width <= 700px) {
    .groups {
      columns: 1;
    }
  }
</style>
