---
import { getText } from "@/utils/i18n"
import type { SectionProps } from "@/types"

const { cv, lang } = Astro.props as SectionProps
const { eyebrow, title } = getText(lang).sections.languages
---

<div>
  <span class="eyebrow">{eyebrow}</span>
  <h2>{title}</h2>
  <ul>
    {
      cv.languages.map(({ language, fluency }) => (
        <li>
          <span class="language">{language}</span>
          <span class="fluency">{fluency}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .eyebrow {
    display: block;
    margin-bottom: 6px;
    color: var(--olive);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    margin-bottom: 1.25rem;
    font-size: clamp(1.6rem, 4vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  @media print {
    h2 {
      margin-bottom: 0.6rem;
      font-size: 1.4rem;
    }

    ul {
      max-width: 320px;
    }
  }

  li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    background: var(--card);
    border: 1px solid var(--line);
  }

  .language {
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .fluency {
    padding: 0.25rem 0.65rem;
    border: 1px solid #564d0630;
    border-radius: 6px;
    background: #564d0614;
    color: #4a3838;
    font-size: 0.78rem;
    font-weight: 500;
  }
</style>
