---
interface Props {
  id?: string
  eyebrow?: string
  title?: string
}

const { id, eyebrow, title } = Astro.props
---

<section id={id}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  {title && <h2>{title}</h2>}
  <slot />
</section>

<style>
  section {
    max-width: 960px;
    margin: 0 auto;
    padding-block: 3.5rem;
  }

  .eyebrow {
    display: block;
    margin-bottom: 6px;
    color: var(--olive);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    margin-bottom: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
    font-size: clamp(1.6rem, 4vw, 2rem);
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  @media (width <= 700px) {
    section {
      padding-block: 2.25rem;
    }
  }

  @media print {
    section {
      padding-block: 1rem;
    }

    h2 {
      margin-bottom: 0.6rem;
      font-size: 1.4rem;
    }
  }
</style>
