---
import Layout from "@/layouts/Layout.astro"
import About from "@/components/sections/About.astro"
import Education from "@/components/sections/Education.astro"
import Experience from "@/components/sections/Experience.astro"
import Hero from "@/components/sections/Hero.astro"
import Projects from "@/components/sections/Projects.astro"
import Skills from "@/components/sections/Skills.astro"
import Idioma from "@/components/sections/Idiomas.astro"
import KeyboardManager from "@/components/KeyboardManager.astro"
import type { CV } from "@/cv"

interface Props {
  cv: CV
  lang: "es" | "en"
}

const { cv, lang } = Astro.props
const { name, label, summary, image, url } = cv.basics
---

<Layout
  title={`${lang === "es" ? "Portafolio" : "Portfolio"} de ${name} - ${label}`}
  summary={summary}
  image={image}
  url={url}
  lang={lang}
>
  <main>
    <Hero cv={cv} lang={lang} />
    <About cv={cv} lang={lang} />
    <Experience cv={cv} lang={lang} />
    <Education cv={cv} lang={lang} />
    <Projects cv={cv} lang={lang} />
    <Skills cv={cv} lang={lang} />
    <Idioma cv={cv} lang={lang} />
  </main>

  <KeyboardManager cv={cv} lang={lang} />
</Layout>

<style>
  main {
    padding: 4rem;
    margin: auto;
    width: 100%;
  }

  @media (width <= 700px) {
    main {
      padding: 2rem;
    }
  }
</style>
